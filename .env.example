# Local bootstrap supplies these defaults without an env file.
PUBLIC_ORIGIN=http://127.0.0.1:4320
LOCAL_OIDC_ORIGIN=http://127.0.0.1:4323
REDIS_URL=redis://127.0.0.1:56389
DB_POOL_SIZE=16
# Run scripts/migrate.mjs and scripts/seed.mjs as the migration owner (local default).
# DATABASE_URL=postgresql://penicillion:local-game@127.0.0.1:55442/penicillion
# scripts/local.mjs uses this restricted login for game workers by default.
# DATABASE_URL=postgresql://night_play:local-play-only@127.0.0.1:55442/penicillion
# Production variables and secret provisioning are described in ops/DEPLOYMENT.md.

# Docker Compose local play. Use distinct host ports for a second isolated stack.
# COMPOSE_PROJECT_NAME=penicillion-night-culture
# GAME_DB_PORT=55442
# GAME_CACHE_PORT=56389
# PLAY_PORT=4320
# LOGIN_PORT=4323
